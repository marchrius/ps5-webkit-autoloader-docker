# IPv4 LAN del computer/NAS Docker, raggiungibile dalla PS5. IP statico o riserva DHCP.
HOST_IP=192.168.1.10
# Indirizzo su cui Docker pubblica le porte. 0.0.0.0 è compatibile con VM Docker.
# Su Linux nativo puoi limitarlo all'IP LAN presente sul server Docker.
BIND_IP=0.0.0.0
# selective: blocca PSN e inoltra il resto; offline: blocca ogni dominio non locale.
DNS_MODE=selective
UPSTREAM_DNS=1.1.1.1,9.9.9.9
LOG_QUERIES=false
AUTOLOADER_VERSION=0.6.1
# Facoltativo: SHA-256 del file .py della release per verificare il download in build.
AUTOLOADER_SHA256=
