# Docker computer/NAS LAN IPv4 reachable from the PS5. Use a static IP or DHCP reservation.
HOST_IP=192.168.1.10
# Address used by Docker to publish ports. 0.0.0.0 works with Docker VMs.
# On native Linux, you can restrict it to a LAN IP assigned to the Docker host.
BIND_IP=0.0.0.0
# Published ports: keep the standard values for PS5 use.
# For Mac tests with occupied ports, use .env.macos.example.
DNS_PORT=53
HTTP_PORT=80
HTTPS_PORT=443
# selective: block PSN and forward other names; offline: block all non-local domains.
DNS_MODE=selective
UPSTREAM_DNS=1.1.1.1,9.9.9.9
LOG_QUERIES=false
AUTOLOADER_VERSION=0.6.1
# Optional: SHA-256 of the release .py file to verify the build-time download.
AUTOLOADER_SHA256=
