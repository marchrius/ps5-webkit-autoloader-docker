# Solo collaudo locale da Mac; non modifica la configurazione macvlan del NAS.
# Imposta HOST_IP all'IPv4 LAN del Mac prima di usare la console o altri client LAN.
HOST_IP=192.168.1.10
BIND_IP=0.0.0.0
DNS_PORT=1053
HTTP_PORT=8080
HTTPS_PORT=8443
DNS_MODE=selective
UPSTREAM_DNS=1.1.1.1,9.9.9.9
LOG_QUERIES=false
AUTOLOADER_VERSION=0.6.1
AUTOLOADER_SHA256=
