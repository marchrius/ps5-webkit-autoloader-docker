# Local Mac testing only; keeps the NAS macvlan configuration separate.
# Set HOST_IP to the Mac's LAN IPv4 before using the console or other LAN clients.
HOST_IP=192.168.1.10
BIND_IP=0.0.0.0
DNS_PORT=1053
HTTP_PORT=8080
HTTPS_PORT=8443
DNS_MODE=selective
UPSTREAM_DNS=1.1.1.1,9.9.9.9
LOG_QUERIES=false
AUTOLOADER_VERSION=0.6.1
AUTOLOADER_SHA256=
