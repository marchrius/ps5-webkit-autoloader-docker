# Dedicated Docker macvlan network on a LAN already used by another network.
# Requires Docker Engine support for multiple macvlan networks on one parent.
COMPOSE_FILE=compose.yaml:compose.macvlan-dedicated.yaml
HOST_IP=192.168.1.20
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.1.0/24

# Required for selective forwarding: a DNS server within the same subnet.
# Use the router only if it provides DNS; public resolvers are not reachable
# from this container without a default route. Offline mode needs no forwarding.
UPSTREAM_DNS=192.168.1.1
DNS_MODE=selective
LOG_QUERIES=false
AUTOLOADER_VERSION=0.6.1
AUTOLOADER_SHA256=
