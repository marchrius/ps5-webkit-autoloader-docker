# Reuse an existing macvlan network on the target Linux host/NAS.
COMPOSE_FILE=compose.yaml:compose.macvlan-external.yaml
# Set the exact network name shown in Portainer Networks or docker network ls.
MACVLAN_NETWORK=macvlan_lan
# Choose an unused container IP within that network's subnet, outside the DHCP pool.
HOST_IP=192.168.1.20

DNS_MODE=selective
UPSTREAM_DNS=1.1.1.1,9.9.9.9
LOG_QUERIES=false
AUTOLOADER_VERSION=0.6.1
AUTOLOADER_SHA256=
