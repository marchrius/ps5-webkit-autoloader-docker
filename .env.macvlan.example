# Dispositivo Linux/NAS: Docker rootful con interfaccia Ethernet LAN.
# Carica automaticamente base + override macvlan (separatore per host Linux).
COMPOSE_FILE=compose.yaml:compose.macvlan.yaml

# IP LIBERO dedicato al container, diverso dall'IP del NAS e fuori dal pool DHCP.
# Sono esempi: verifica e adatta tutti i valori alla tua rete.
HOST_IP=192.168.1.20
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1

DNS_MODE=selective
UPSTREAM_DNS=1.1.1.1,9.9.9.9
LOG_QUERIES=false
AUTOLOADER_VERSION=0.5.2
AUTOLOADER_SHA256=
