# Linux host/NAS: rootful Docker with an Ethernet LAN interface.
# Automatically load the base and macvlan override (Linux host separator).
COMPOSE_FILE=compose.yaml:compose.macvlan.yaml

# UNUSED dedicated container IP, different from the NAS IP and outside the DHCP pool.
# These are examples: check and adapt all values to your network.
HOST_IP=192.168.1.20
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1

DNS_MODE=selective
UPSTREAM_DNS=1.1.1.1,9.9.9.9
LOG_QUERIES=false
AUTOLOADER_VERSION=0.6.1
AUTOLOADER_SHA256=
